# Remote providers
GEMINI_API_KEY=your_google_ai_studio_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here

# Model overrides
GEMINI_CONTEXT_MODEL=gemini-3.1-pro-preview
GEMINI_WEB_MODEL=gemini-2.5-flash
GEMINI_CONTEXT_CACHE_TTL=600s
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LOGIC_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_TECHNICAL_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_REQUEST_TIMEOUT=600

# Local providers
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_REQUEST_TIMEOUT=120
OLLAMA_STYLE_MODEL=qwen3:8b
OLLAMA_REWRITE_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Deprecated aliases still supported during migration
# GEMINI_MODEL=gemini-3.1-pro-preview
# OLLAMA_CHAT_MODEL=qwen3:8b
